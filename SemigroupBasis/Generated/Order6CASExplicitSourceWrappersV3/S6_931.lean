    _ = SemigroupBasis.Generated.Order6CASExplicitSourceAdapters.S6_883Representative.oppositeTable.semigroup.mul (sourceLabel left)
          ((representativeTail right).foldl
            (fun value generator =>
              SemigroupBasis.Generated.Order6CASExplicitSourceAdapters.S6_883Representative.oppositeTable.semigroup.mul value
                (generatorSourceLabel generator))
            (generatorSourceLabel (representativeHead right))) :=
      sourceFoldlGeneratorAssoc _ _ _
