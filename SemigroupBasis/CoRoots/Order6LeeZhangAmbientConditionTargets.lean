private def condition7CyclicIntoParityZero :
    Embedding Condition7.cyclic parityZero where
  toFun := fun value => if value = 0 then (0 : Fin 3) else 1
  map_mul := by
    intro left right
    exact by decide +revert
  injective := by
    intro left right
    exact by decide +revert

private def condition14CyclicIntoParityZero :
    Embedding Condition14.cyclic parityZero where
  toFun := fun value => if value = 0 then (0 : Fin 3) else 1
