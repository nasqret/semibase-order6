private def productEmbeddingRight
    {A : Type u} {B : Type v} {C : Type w}
    {G : Semigroup A} {H : Semigroup B} (K : Semigroup C)
    (embedding : Embedding G H) :
    Embedding (G.prod K) (H.prod K) where
  toFun := fun value => (embedding.toFun value.1, value.2)
  map_mul := by
    intro left right
    apply Prod.ext
    · exact embedding.map_mul left.1 right.1
    · rfl
  injective := by
    intro left right equality
    apply Prod.ext
    · apply embedding.injective
      exact congrArg (fun value : B × C => value.1) equality
    · exact congrArg (fun value : B × C => value.2) equality

private theorem parityModelsCondition7 :
    Models parityZero Condition7.basis :=
  modelsOfFiniteChecksThree Condition7.basis (by decide)
    parityZeroTable (by decide)

private theorem parityModelsCondition7Opposite :
    Models parityZero Condition7.oppositeBasis :=
  modelsOfFiniteChecksThree Condition7.oppositeBasis (by decide)
    parityZeroTable (by decide)

private theorem condition7S3Product_basisFor
    (complete : Condition7.DerivationalObligation) :
    BasisFor (parityZero.prod Condition7.core) Condition7.basis :=
  (Condition7.product_basisFor complete).inheritAlongEmbedding
    (productEmbeddingRight Condition7.core condition7CyclicIntoParityZero)
    (modelsProduct parityModelsCondition7 Condition7.coreModels)

private theorem condition7Cyclic_mul_comm
    (left right : Fin 2) :
    Condition7.cyclic.mul left right =
      Condition7.cyclic.mul right left := by
  exact by decide +revert

private def condition7OppositeProductIntoS3CoreOpposite :
    Embedding Condition7.product.opposite
      (parityZero.prod Condition7.core.opposite) where
  toFun := fun value =>
    (condition7CyclicIntoParityZero.toFun value.1, value.2)
  map_mul := by
    intro left right
    apply Prod.ext
    · change
        condition7CyclicIntoParityZero.toFun
            (Condition7.cyclic.mul right.1 left.1) =
          parityZero.mul
            (condition7CyclicIntoParityZero.toFun left.1)
            (condition7CyclicIntoParityZero.toFun right.1)
      rw [condition7Cyclic_mul_comm right.1 left.1]
      exact condition7CyclicIntoParityZero.map_mul left.1 right.1
    · rfl
  injective := by
    intro left right equality
    apply Prod.ext
    · apply condition7CyclicIntoParityZero.injective
      exact congrArg (fun value : Fin 3 × Fin 5 => value.1) equality
    · exact congrArg (fun value : Fin 3 × Fin 5 => value.2) equality

