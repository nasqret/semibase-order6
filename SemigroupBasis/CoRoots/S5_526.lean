import SemigroupBasis.CoRoots.S5_526Semantics
import SemigroupBasis.Opposite

namespace SemigroupBasis.CoRoots.S5_526

open SemigroupBasis

/-- Unconditional exact-basis theorem for the stored representative. -/
theorem representative_basis :
    BasisFor table.semigroup basis :=
  basis_complete_of_signature table models valid_signature_eq

def oppositeBasis : List (Identity Nat) :=
  reversedBasis basis

def yxx : Word Nat := ⟨1, [0, 0]⟩
def yyx : Word Nat := ⟨1, [1, 0]⟩
def zyx : Word Nat := ⟨2, [1, 0]⟩

def expectedOppositeBasis : List (Identity Nat) :=
  [
    ⟨xxx, yxx⟩,
    ⟨xyx, yyx⟩,
    ⟨xyx, zyx⟩
  ]

theorem oppositeBasis_eq_expected :
    oppositeBasis = expectedOppositeBasis := by
  rfl

/-- Unconditional literal reverse-word basis for the opposite table. -/
theorem opposite_basis :
    BasisFor table.semigroup.opposite expectedOppositeBasis := by
  rw [← oppositeBasis_eq_expected]
  exact representative_basis.oppositeReversed

/-- Exact syntactic description of the congruence generated by the basis. -/
theorem derives_iff_signature_eq
    {left right : Word Nat} :
    Derives basis left right ↔
      signature left = signature right := by
  constructor
  · intro derivation
    exact valid_signature_eq ⟨left, right⟩
      (derivation.sound models)
  · exact derivesOfSignatureEq

end SemigroupBasis.CoRoots.S5_526
