inductive FrozenDirection where
  | forward
  | reverse
deriving DecidableEq, Repr

/-- One oriented frozen path under an equal two-sided list context. -/
structure ContextualFrozenWitness where
  rule : FrozenPathInstantiation
  direction : FrozenDirection
  leftContext : List Nat
  rightContext : List Nat

namespace ContextualFrozenWitness

def coreSource (witness : ContextualFrozenWitness) : Word Nat :=
  match witness.direction with
  | .forward => witness.rule.source
  | .reverse => witness.rule.target

def coreTarget (witness : ContextualFrozenWitness) : Word Nat :=
  match witness.direction with
  | .forward => witness.rule.target
  | .reverse => witness.rule.source

def source (witness : ContextualFrozenWitness) : List Nat :=
  witness.leftContext ++ witness.coreSource.toList ++ witness.rightContext

def target (witness : ContextualFrozenWitness) : List Nat :=
  witness.leftContext ++ witness.coreTarget.toList ++ witness.rightContext

theorem coreDerives (witness : ContextualFrozenWitness) :
    Derives basis witness.coreSource witness.coreTarget := by
  cases witness with
  | mk rule direction leftContext rightContext =>
      cases direction with
      | forward =>
          have forwardEndpointBridge :
              Derives basis
                (coreSource
                  (ContextualFrozenWitness.mk rule .forward
                    leftContext rightContext))
                (coreTarget
                  (ContextualFrozenWitness.mk rule .forward
                    leftContext rightContext)) :=
            rule.derives
          exact forwardEndpointBridge
      | reverse =>
          have reverseEndpointBridge :
              Derives basis
                (coreSource
                  (ContextualFrozenWitness.mk rule .reverse
                    leftContext rightContext))
                (coreTarget
                  (ContextualFrozenWitness.mk rule .reverse
                    leftContext rightContext)) :=
            rule.derives.symm
          exact reverseEndpointBridge

theorem listDerives (witness : ContextualFrozenWitness) :
    S5_107.ListDerives basis witness.source witness.target := by
  have coreListEndpoints :
      S5_107.ListDerives basis
        witness.coreSource.toList
        witness.coreTarget.toList :=
    S5_107.ListDerives.ofWord witness.coreDerives
  have contextualListEndpoints :
      S5_107.ListDerives basis
        (witness.leftContext ++
          witness.coreSource.toList ++ witness.rightContext)
        (witness.leftContext ++
          witness.coreTarget.toList ++ witness.rightContext) :=
    S5_107.ListDerives.context witness.leftContext witness.rightContext
      coreListEndpoints
  have sourceEndpointBridge :
      witness.leftContext ++
          witness.coreSource.toList ++ witness.rightContext =
        witness.source := rfl
  have targetEndpointBridge :
      witness.leftContext ++
          witness.coreTarget.toList ++ witness.rightContext =
        witness.target := rfl
  have endpointTypeBridge :
      S5_107.ListDerives basis
          (witness.leftContext ++
            witness.coreSource.toList ++ witness.rightContext)
          (witness.leftContext ++
            witness.coreTarget.toList ++ witness.rightContext) =
        S5_107.ListDerives basis witness.source witness.target :=
    (congrArg
      (fun source : List Nat =>
        S5_107.ListDerives basis source
          (witness.leftContext ++
            witness.coreTarget.toList ++ witness.rightContext))
      sourceEndpointBridge).trans
      (congrArg
        (fun target : List Nat =>
          S5_107.ListDerives basis witness.source target)
        targetEndpointBridge)
  exact Eq.mp endpointTypeBridge contextualListEndpoints

end ContextualFrozenWitness

/-- Exactly one contextual application of one of the 49 frozen paths, in
either orientation. -/
def ContextualFrozenStep (left right : List Nat) : Prop :=
  ∃ witness : ContextualFrozenWitness,
    left = witness.source ∧ right = witness.target

theorem contextualFrozenStep_listDerives
    {left right : List Nat}
    (step : ContextualFrozenStep left right) :
    S5_107.ListDerives basis left right := by
  obtain ⟨witness, rfl, rfl⟩ := step
  exact witness.listDerives

/-! Every generated context equality below uses the same record-compatible
extended-context intermediate

  `(outerLeft ++ leftContext) ++ (core ++ (rightContext ++ outerRight))`.

The only direction split is isolated in the typed endpoint bridge. -/

private theorem contextualFrozenWitness_extended_coreEndpoints
    (witness : ContextualFrozenWitness)
    (outerLeft outerRight : List Nat) :
    let extended : ContextualFrozenWitness :=
      { witness with
          leftContext := outerLeft ++ witness.leftContext
          rightContext := witness.rightContext ++ outerRight }
    extended.coreSource = witness.coreSource ∧
      extended.coreTarget = witness.coreTarget := by
  cases witness with
  | mk rule direction leftContext rightContext =>
      cases direction <;> exact ⟨rfl, rfl⟩

private theorem appendContext_extendedAssociation
    (outerLeft leftContext core rightContext outerRight : List Nat) :
    outerLeft ++
        ((leftContext ++ (core ++ rightContext)) ++ outerRight) =
      (outerLeft ++ leftContext) ++
        (core ++ (rightContext ++ outerRight)) := by
  simp only [List.append_assoc]

/-- A frozen step remains a frozen step after adding an equal outer context. -/
theorem contextualFrozenStep_context
    {left right : List Nat}
    (step : ContextualFrozenStep left right)
    (outerLeft outerRight : List Nat) :
    ContextualFrozenStep
      (outerLeft ++ left ++ outerRight)
      (outerLeft ++ right ++ outerRight) := by
  obtain ⟨witness, rfl, rfl⟩ := step
  let extended : ContextualFrozenWitness :=
    { witness with
        leftContext := outerLeft ++ witness.leftContext
        rightContext := witness.rightContext ++ outerRight }
  have endpointBridges :
      extended.coreSource = witness.coreSource ∧
        extended.coreTarget = witness.coreTarget :=
    contextualFrozenWitness_extended_coreEndpoints
      witness outerLeft outerRight
  have sourceEndpointBridge :
      extended.coreSource = witness.coreSource :=
    endpointBridges.1
  have targetEndpointBridge :
      extended.coreTarget = witness.coreTarget :=
    endpointBridges.2
  have witnessSourceDefinitionBridge :
      witness.source =
        witness.leftContext ++
          (witness.coreSource.toList ++ witness.rightContext) := by
    change
      (witness.leftContext ++ witness.coreSource.toList) ++
          witness.rightContext =
        witness.leftContext ++
          (witness.coreSource.toList ++ witness.rightContext)
    exact List.append_assoc
      witness.leftContext witness.coreSource.toList witness.rightContext
  have witnessTargetDefinitionBridge :
      witness.target =
        witness.leftContext ++
          (witness.coreTarget.toList ++ witness.rightContext) := by
    change
      (witness.leftContext ++ witness.coreTarget.toList) ++
          witness.rightContext =
        witness.leftContext ++
          (witness.coreTarget.toList ++ witness.rightContext)
    exact List.append_assoc
      witness.leftContext witness.coreTarget.toList witness.rightContext
  have sourceOuterDefinitionBridge :
      outerLeft ++ (witness.source ++ outerRight) =
        outerLeft ++
          ((witness.leftContext ++
            (witness.coreSource.toList ++ witness.rightContext)) ++
            outerRight) :=
    congrArg
      (fun middle : List Nat => outerLeft ++ (middle ++ outerRight))
      witnessSourceDefinitionBridge
  have targetOuterDefinitionBridge :
      outerLeft ++ (witness.target ++ outerRight) =
        outerLeft ++
          ((witness.leftContext ++
            (witness.coreTarget.toList ++ witness.rightContext)) ++
            outerRight) :=
    congrArg
      (fun middle : List Nat => outerLeft ++ (middle ++ outerRight))
      witnessTargetDefinitionBridge
  have sourceAssociationBridge :
      outerLeft ++ (witness.source ++ outerRight) =
        (outerLeft ++ witness.leftContext) ++
          (witness.coreSource.toList ++
            (witness.rightContext ++ outerRight)) :=
    sourceOuterDefinitionBridge.trans
      (appendContext_extendedAssociation
        outerLeft witness.leftContext witness.coreSource.toList
        witness.rightContext outerRight)
  have targetAssociationBridge :
      outerLeft ++ (witness.target ++ outerRight) =
        (outerLeft ++ witness.leftContext) ++
          (witness.coreTarget.toList ++
            (witness.rightContext ++ outerRight)) :=
    targetOuterDefinitionBridge.trans
      (appendContext_extendedAssociation
        outerLeft witness.leftContext witness.coreTarget.toList
        witness.rightContext outerRight)
  have sourceCoreRepresentationBridge :
      (outerLeft ++ witness.leftContext) ++
          (witness.coreSource.toList ++
            (witness.rightContext ++ outerRight)) =
        (outerLeft ++ witness.leftContext) ++
          (extended.coreSource.toList ++
            (witness.rightContext ++ outerRight)) :=
    congrArg
      (fun endpoint : Word Nat =>
        (outerLeft ++ witness.leftContext) ++
          (endpoint.toList ++ (witness.rightContext ++ outerRight)))
      sourceEndpointBridge.symm
  have targetCoreRepresentationBridge :
      (outerLeft ++ witness.leftContext) ++
          (witness.coreTarget.toList ++
            (witness.rightContext ++ outerRight)) =
        (outerLeft ++ witness.leftContext) ++
          (extended.coreTarget.toList ++
            (witness.rightContext ++ outerRight)) :=
    congrArg
      (fun endpoint : Word Nat =>
        (outerLeft ++ witness.leftContext) ++
          (endpoint.toList ++ (witness.rightContext ++ outerRight)))
      targetEndpointBridge.symm
  have extendedSourceDefinitionBridge :
      (outerLeft ++ witness.leftContext) ++
          (extended.coreSource.toList ++
            (witness.rightContext ++ outerRight)) =
        extended.source := by
    change
      (outerLeft ++ witness.leftContext) ++
          (extended.coreSource.toList ++
            (witness.rightContext ++ outerRight)) =
        ((outerLeft ++ witness.leftContext) ++
          extended.coreSource.toList) ++
          (witness.rightContext ++ outerRight)
    exact (List.append_assoc
      (outerLeft ++ witness.leftContext) extended.coreSource.toList
      (witness.rightContext ++ outerRight)).symm
  have extendedTargetDefinitionBridge :
      (outerLeft ++ witness.leftContext) ++
          (extended.coreTarget.toList ++
            (witness.rightContext ++ outerRight)) =
        extended.target := by
    change
      (outerLeft ++ witness.leftContext) ++
          (extended.coreTarget.toList ++
            (witness.rightContext ++ outerRight)) =
        ((outerLeft ++ witness.leftContext) ++
          extended.coreTarget.toList) ++
          (witness.rightContext ++ outerRight)
    exact (List.append_assoc
      (outerLeft ++ witness.leftContext) extended.coreTarget.toList
      (witness.rightContext ++ outerRight)).symm
  have sourceRepresentationBridge :
      (outerLeft ++ witness.leftContext) ++
          (witness.coreSource.toList ++
            (witness.rightContext ++ outerRight)) =
        extended.source :=
    sourceCoreRepresentationBridge.trans
      extendedSourceDefinitionBridge
  have targetRepresentationBridge :
      (outerLeft ++ witness.leftContext) ++
          (witness.coreTarget.toList ++
            (witness.rightContext ++ outerRight)) =
        extended.target :=
    targetCoreRepresentationBridge.trans
      extendedTargetDefinitionBridge
  have outerSourceAssociationBridge :
      (outerLeft ++ witness.source) ++ outerRight =
        outerLeft ++ (witness.source ++ outerRight) :=
    List.append_assoc outerLeft witness.source outerRight
  have outerTargetAssociationBridge :
      (outerLeft ++ witness.target) ++ outerRight =
        outerLeft ++ (witness.target ++ outerRight) :=
    List.append_assoc outerLeft witness.target outerRight
  exact ⟨extended,
    outerSourceAssociationBridge.trans
      (sourceAssociationBridge.trans sourceRepresentationBridge),
    outerTargetAssociationBridge.trans
      (targetAssociationBridge.trans targetRepresentationBridge)⟩

/-- Reflexive-transitive closure with an explicit constructor orientation. -/
inductive ContextualFrozenRTC : List Nat → List Nat → Prop where
  | refl (letters : List Nat) : ContextualFrozenRTC letters letters
  | cons {left middle right : List Nat}
      (step : ContextualFrozenStep left middle)
      (rest : ContextualFrozenRTC middle right) :
      ContextualFrozenRTC left right

namespace ContextualFrozenRTC

theorem trans
    {left middle right : List Nat}
    (first : ContextualFrozenRTC left middle)
    (second : ContextualFrozenRTC middle right) :
    ContextualFrozenRTC left right := by
  induction first generalizing right with
  | refl _ => exact second
  | cons step rest inductionHypothesis =>
      exact ContextualFrozenRTC.cons step (inductionHypothesis second)

theorem context
    {left right : List Nat}
    (reachable : ContextualFrozenRTC left right)
    (outerLeft outerRight : List Nat) :
    ContextualFrozenRTC
      (outerLeft ++ left ++ outerRight)
      (outerLeft ++ right ++ outerRight) := by
  induction reachable with
  | refl letters => exact ContextualFrozenRTC.refl _
  | cons step rest inductionHypothesis =>
      exact ContextualFrozenRTC.cons
        (contextualFrozenStep_context step outerLeft outerRight)
        inductionHypothesis

end ContextualFrozenRTC

theorem contextualFrozenRTC_listDerives
    {left right : List Nat}
    (reachable : ContextualFrozenRTC left right) :
    S5_107.ListDerives basis left right := by
  induction reachable with
  | refl letters => exact S5_107.ListDerives.refl letters
  | cons step rest inductionHypothesis =>
      exact
        (contextualFrozenStep_listDerives step).trans
          inductionHypothesis

/-- RTC soundness at nonempty word endpoints. -/
theorem contextualFrozenRTC_derives
    {left right : Word Nat}
    (reachable : ContextualFrozenRTC left.toList right.toList) :
    Derives basis left right := by
  cases left with
  | mk leftHead leftTail =>
      cases right with
      | mk rightHead rightTail =>
          have listedEndpoints :
              Derives basis
                (S5_107.listWordOfCons leftHead leftTail)
                (S5_107.listWordOfCons rightHead rightTail) :=
            S5_107.ListDerives.toWord
              (contextualFrozenRTC_listDerives reachable)
          have sourceEndpointBridge :
              S5_107.listWordOfCons leftHead leftTail =
                Word.mk leftHead leftTail := rfl
          have targetEndpointBridge :
              S5_107.listWordOfCons rightHead rightTail =
                Word.mk rightHead rightTail := rfl
          have endpointTypeBridge :
              Derives basis
                  (S5_107.listWordOfCons leftHead leftTail)
                  (S5_107.listWordOfCons rightHead rightTail) =
                Derives basis
                  (Word.mk leftHead leftTail)
                  (Word.mk rightHead rightTail) :=
            (congrArg
              (fun source : Word Nat =>
                Derives basis source
                  (S5_107.listWordOfCons rightHead rightTail))
              sourceEndpointBridge).trans
              (congrArg
                (fun target : Word Nat =>
                  Derives basis (Word.mk leftHead leftTail) target)
                targetEndpointBridge)
          exact Eq.mp endpointTypeBridge listedEndpoints

private theorem toList_appendSingleton_bridge
    (word : Word Nat) (letter : Nat) :
    (word ++ Word.singleton letter).toList =
      word.toList ++ [letter] := by
  have appendBridge :
      (word ++ Word.singleton letter).toList =
        word.toList ++ (Word.singleton letter).toList :=
    Word.toList_append word (Word.singleton letter)
  have singletonBridge :
      word.toList ++ (Word.singleton letter).toList =
        word.toList ++ [letter] :=
    congrArg (fun suffix : List Nat => word.toList ++ suffix)
      (Word.toList_singleton letter)
  exact appendBridge.trans singletonBridge

/-- Lift a word-endpoint RTC route underneath one appended letter. -/
theorem contextualFrozenRTC_appendSingleton
    {left right : Word Nat}
    (reachable : ContextualFrozenRTC left.toList right.toList)
    (letter : Nat) :
    ContextualFrozenRTC
      (left ++ Word.singleton letter).toList
      (right ++ Word.singleton letter).toList := by
  have contextualRoute :
      ContextualFrozenRTC
        (left.toList ++ [letter])
        (right.toList ++ [letter]) :=
    ContextualFrozenRTC.context reachable [] [letter]
  have sourceEndpointBridge :
      (left ++ Word.singleton letter).toList =
        left.toList ++ [letter] :=
    toList_appendSingleton_bridge left letter
  have targetEndpointBridge :
      (right ++ Word.singleton letter).toList =
        right.toList ++ [letter] :=
    toList_appendSingleton_bridge right letter
  have routeTypeBridge :
      ContextualFrozenRTC
          (left ++ Word.singleton letter).toList
          (right ++ Word.singleton letter).toList =
        ContextualFrozenRTC
          (left.toList ++ [letter])
          (right.toList ++ [letter]) :=
    (congrArg
      (fun source : List Nat =>
        ContextualFrozenRTC source
          (right ++ Word.singleton letter).toList)
      sourceEndpointBridge).trans
      (congrArg
        (fun target : List Nat =>
          ContextualFrozenRTC (left.toList ++ [letter]) target)
        targetEndpointBridge)
  exact Eq.mpr routeTypeBridge contextualRoute

