import SemigroupBasis.CoRoots.S5_303Semantics

set_option maxRecDepth 100000

namespace SemigroupBasis.CoRoots.S5_303

open SemigroupBasis

abbrev table : FiniteTable :=
  Generated.Catalogue.S5_303.table

theorem models :
    Models table.semigroup basis :=
  models_of_finite_checks table (by decide)

/-- Unconditional exact-basis theorem for the stored representative. -/
theorem representative_basis :
    BasisFor table.semigroup basis :=
  basis_complete_of_contentEndpoint
    table.semigroup models valid_signature

/-- Unconditional literal reverse-word basis for the opposite table. -/
theorem opposite_basis :
    BasisFor table.semigroup.opposite expectedOppositeBasis := by
  rw [← oppositeBasis_eq_expected]
  exact representative_basis.oppositeReversed

/-- Exact syntactic characterization of the congruence generated by the
three displayed laws. -/
theorem derives_iff_sameContentEndpointSignature
    {left right : Word Nat} :
    Derives basis left right ↔
      SameContentEndpointSignature left right := by
  constructor
  · intro derivation
    exact valid_signature ⟨left, right⟩
      (derivation.sound models)
  · exact derives_of_sameContentEndpointSignature

end SemigroupBasis.CoRoots.S5_303
