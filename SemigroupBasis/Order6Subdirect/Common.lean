namespace SemigroupBasis

/-- Binary direct product of two explicitly supplied semigroup structures. -/
def Semigroup.prod (G : Semigroup A) (H : Semigroup B) : Semigroup (A × B) where
  mul := fun p q => (G.mul p.1 q.1, H.mul p.2 q.2)
  assoc := by
    intro a b c
    show (G.mul (G.mul a.1 b.1) c.1, H.mul (H.mul a.2 b.2) c.2) =
      (G.mul a.1 (G.mul b.1 c.1), H.mul a.2 (H.mul b.2 c.2))
    rw [G.assoc, H.assoc]

namespace Hom

/-- First projection of a binary product, as a homomorphism. -/
def prodFst (G : Semigroup A) (H : Semigroup B) : Hom (G.prod H) G where
  toFun := Prod.fst
  map_mul := by intros; rfl

/-- Second projection of a binary product, as a homomorphism. -/
def prodSnd (G : Semigroup A) (H : Semigroup B) : Hom (G.prod H) H where
  toFun := Prod.snd
  map_mul := by intros; rfl

end Hom

namespace Embedding

/-- Embed the right factor into a product by fixing an idempotent in the left
factor. -/
def prodRightOfIdempotent
    (G : Semigroup A) (H : Semigroup B) (left : A)
    (leftIdempotent : G.mul left left = left) :
    Embedding H (G.prod H) where
  toFun := fun right => (left, right)
  map_mul := by
    intro first second
    apply Prod.ext
    · exact leftIdempotent.symm
    · rfl
  injective := by
    intro first second equal
    exact congrArg Prod.snd equal

/-- Embed the left factor into a product by fixing an idempotent in the right
factor. -/
def prodLeftOfIdempotent
    (G : Semigroup A) (H : Semigroup B) (right : B)
    (rightIdempotent : H.mul right right = right) :
    Embedding G (G.prod H) where
  toFun := fun left => (left, right)
  map_mul := by
    intro first second
    apply Prod.ext
    · rfl
    · exact rightIdempotent.symm
  injective := by
    intro first second equal
    exact congrArg Prod.fst equal

end Embedding

namespace Semigroup

/-- Evaluation in a binary product is componentwise evaluation. -/
theorem prod_eval (G : Semigroup A) (H : Semigroup B)
    (valuation : α → A × B) (word : Word α) :
    (G.prod H).eval valuation word =
      (G.eval (fun x => (valuation x).1) word,
        H.eval (fun x => (valuation x).2) word) := by
  have h1 : ((G.prod H).eval valuation word).1 =
      G.eval (fun x => (valuation x).1) word :=
    (Hom.prodFst G H).map_eval valuation word
  have h2 : ((G.prod H).eval valuation word).2 =
      H.eval (fun x => (valuation x).2) word :=
    (Hom.prodSnd G H).map_eval valuation word
  rw [← h1, ← h2]

end Semigroup

namespace Identity

/-- An identity valid in both factors is valid in their product. -/
theorem satisfiedBy_prod {G : Semigroup A} {H : Semigroup B}
    {e : Identity α}
    (hG : e.SatisfiedBy G) (hH : e.SatisfiedBy H) :
    e.SatisfiedBy (G.prod H) := by
  intro valuation
  rw [Semigroup.prod_eval, Semigroup.prod_eval,
    hG (fun x => (valuation x).1), hH (fun x => (valuation x).2)]

end Identity

/-- A basis of the right factor is a basis of the product whenever the left
factor models it and supplies an idempotent.  This is the embedded-factor
identity-theory sandwich used throughout the order-six reuse campaign. -/
theorem BasisFor.inheritToProdRight
    {G : Semigroup A} {H : Semigroup B}
    {basis : List (Identity α)}
    (rightBasis : BasisFor H basis)
    (leftModels : Models G basis)
    (left : A) (leftIdempotent : G.mul left left = left) :
    BasisFor (G.prod H) basis :=
  rightBasis.inheritAlongEmbedding
    (Embedding.prodRightOfIdempotent G H left leftIdempotent)
    (fun identity member =>
      Identity.satisfiedBy_prod
        (leftModels identity member)
        (rightBasis.1 identity member))

/-- Symmetric product inheritance from a basis of the left factor. -/
theorem BasisFor.inheritToProdLeft
    {G : Semigroup A} {H : Semigroup B}
    {basis : List (Identity α)}
    (leftBasis : BasisFor G basis)
    (rightModels : Models H basis)
    (right : B) (rightIdempotent : H.mul right right = right) :
    BasisFor (G.prod H) basis :=
  leftBasis.inheritAlongEmbedding
    (Embedding.prodLeftOfIdempotent G H right rightIdempotent)
    (fun identity member =>
      Identity.satisfiedBy_prod
        (leftBasis.1 identity member)
        (rightModels identity member))

namespace Order6Subdirect

/-- A split subdirect presentation has the identity theory of its product
hull. This compatibility theorem is stated with the campaign's tracked
`Embedding` and `SplitSurjection` APIs. -/
theorem sameIdentityTheoryOver_prod_of_subdirect
    {T : Semigroup C} {G : Semigroup A} {H : Semigroup B}
    (into : Embedding T (G.prod H))
    (ontoG : SplitSurjection T G) (ontoH : SplitSurjection T H)
    (α : Type u) :
    SameIdentityTheoryOver T (G.prod H) α := by
  intro e
  constructor
  · intro hT
    exact Identity.satisfiedBy_prod
      (ontoG.pushforwardIdentity e hT) (ontoH.pushforwardIdentity e hT)
  · intro hProd
    exact into.pullback_identity e hProd

/-- Finite basability transfers across a split subdirect presentation. -/
theorem finitelyBased_iff_prod_of_subdirect
    {T : Semigroup C} {G : Semigroup A} {H : Semigroup B}
    (into : Embedding T (G.prod H))
    (ontoG : SplitSurjection T G) (ontoH : SplitSurjection T H) :
    FinitelyBased T ↔ FinitelyBased (G.prod H) :=
  finitelyBased_iff_of_sameIdentityTheory
    (sameIdentityTheoryOver_prod_of_subdirect into ontoG ontoH Nat)

/-- Every basis transfers across a split subdirect presentation. -/
theorem basisFor_iff_prod_of_subdirect
    {T : Semigroup C} {G : Semigroup A} {H : Semigroup B}
    {basis : List (Identity α)}
    (into : Embedding T (G.prod H))
    (ontoG : SplitSurjection T G) (ontoH : SplitSurjection T H) :
    BasisFor T basis ↔ BasisFor (G.prod H) basis :=
  basisFor_iff_of_sameIdentityTheoryOver
    (sameIdentityTheoryOver_prod_of_subdirect into ontoG ontoH _)

/-- The opposite of a stored finite table (transposed Cayley matrix). -/
def oppositeTable (T : FiniteTable) : FiniteTable where
  order := T.order
  mul := fun a b => T.mul b a
  assoc := fun a b c => (T.assoc c b a).symm

/-- The opposite table presents exactly the opposite semigroup. -/
theorem oppositeTable_semigroup (T : FiniteTable) :
    (oppositeTable T).semigroup = T.semigroup.opposite :=
  rfl

/-- Split surjection from a binary product onto its first factor; the second
coordinate of the preimage is pinned to a supplied element, so no choice
principle is involved. -/
def prodFstSplit {A : Type u} {B : Type v} (G : Semigroup A) (H : Semigroup B)
    (b : B) : SplitSurjection (G.prod H) G where
  toFun := Prod.fst
  map_mul := fun _ _ => rfl
  preimage := fun a => (a, b)
  right_inverse := fun _ => rfl

/-- Split surjection from a binary product onto its second factor. -/
def prodSndSplit {A : Type u} {B : Type v} (G : Semigroup A) (H : Semigroup B)
    (a : A) : SplitSurjection (G.prod H) H where
  toFun := Prod.snd
  map_mul := fun _ _ => rfl
  preimage := fun b => (a, b)
  right_inverse := fun _ => rfl

/-- Reflected soundness: a `Nat`-variable basis obtained by mapping
finite-variable identities is modeled by any table whose exhaustive finite
checks all pass (`decide`-dischargeable hypothesis). -/
theorem models_of_finite_checks {k : Nat} (T : FiniteTable)
    (finite : List (Identity (Fin k)))
    (checks : finite.all T.checkIdentity = true) :
    Models T.semigroup (finite.map (Identity.map Fin.val)) := by
  intro e he
  match List.mem_map.mp he with
  | ⟨f, mem, mapped⟩ =>
    exact mapped ▸ T.checkIdentityNat_sound f
      ((List.all_eq_true.mp checks) f mem)

end Order6Subdirect
