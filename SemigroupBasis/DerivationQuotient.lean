import SemigroupBasis.Congruence

namespace SemigroupBasis

namespace Word

/-- Concatenation as an explicit semigroup structure on nonempty words. -/
def appendSemigroup (α : Type u) : Semigroup (Word α) where
  mul := fun u v => u ++ v
  assoc := append_assoc

@[simp]
theorem appendSemigroup_mul (u v : Word α) :
    (appendSemigroup α).mul u v = u ++ v :=
  rfl

/-- Evaluation in the word semigroup is simultaneous word substitution. -/
@[simp]
theorem appendSemigroup_eval (valuation : α → Word β) (w : Word α) :
    (appendSemigroup β).eval valuation w = w.bind valuation :=
  rfl

@[simp]
theorem bind_singleton (w : Word α) :
    w.bind (fun x => singleton x) = w := by
  apply toList_injective
  rw [toList_bind]
  change w.toList.flatMap (fun x => [x]) = w.toList
  have flatMap_singletons (xs : List α) :
      xs.flatMap (fun x => [x]) = xs := by
    induction xs with
    | nil => rfl
    | cons x xs ih =>
        simp only [List.flatMap_cons, List.singleton_append, ih]
  exact flatMap_singletons w.toList

end Word

/-- Derivability is the congruence generated by a semigroup identity basis. -/
def derivationCongruence {α : Type u} (basis : List (Identity α)) :
    Semigroup.Congruence (Word.appendSemigroup α) where
  r := Derives basis
  iseqv := {
    refl := Derives.refl
    symm := fun h => Derives.symm h
    trans := fun h₁ h₂ => Derives.trans h₁ h₂
  }
  mul_compat := by
    intro a₁ a₂ b₁ b₂ ha hb
    exact Derives.trans
      (Derives.appendRight ha b₁)
      (Derives.prepend a₂ hb)

/-- The quotient of words by derivability from `basis`. -/
abbrev DerivationQuotient {α : Type u}
    (basis : List (Identity α)) : Type u :=
  (derivationCongruence basis).Quotient

/-- The carrier of the term semigroup presented by `basis`. -/
abbrev TermSemigroup {α : Type u}
    (basis : List (Identity α)) : Type u :=
  DerivationQuotient basis

/-- The quotient semigroup presented by `basis`. -/
def termSemigroup {α : Type u} (basis : List (Identity α)) :
    Semigroup (TermSemigroup basis) :=
  (derivationCongruence basis).quotientSemigroup

/-- The canonical derivability class of a word. -/
def termClass {α : Type u} (basis : List (Identity α))
    (w : Word α) : TermSemigroup basis :=
  (derivationCongruence basis).classOf w

@[simp]
theorem termSemigroup_mul_termClass {α : Type u}
    (basis : List (Identity α)) (u v : Word α) :
    (termSemigroup basis).mul (termClass basis u) (termClass basis v) =
      termClass basis (u ++ v) :=
  rfl

/-- The canonical homomorphism from words to their derivability classes. -/
def termProjection {α : Type u} (basis : List (Identity α)) :
    Hom (Word.appendSemigroup α) (termSemigroup basis) :=
  (derivationCongruence basis).projection

@[simp]
theorem termProjection_apply {α : Type u}
    (basis : List (Identity α)) (w : Word α) :
    (termProjection basis).toFun w = termClass basis w :=
  rfl

/-- Two canonical classes agree exactly when their words are derivable. -/
theorem termClass_eq_iff_derives {α : Type u}
    (basis : List (Identity α)) {u v : Word α} :
    termClass basis u = termClass basis v ↔ Derives basis u v := by
  change
    (derivationCongruence basis).classOf u =
        (derivationCongruence basis).classOf v ↔
      (derivationCongruence basis).r u v
  exact (derivationCongruence basis).classOf_eq_iff

/-- `map_eval` specialized to the canonical projection. -/
theorem termClass_bind {α : Type u} (basis : List (Identity α))
    (substitution : α → Word α) (w : Word α) :
    termClass basis (w.bind substitution) =
      (termSemigroup basis).eval
        (fun x => termClass basis (substitution x)) w := by
  simpa only [Word.appendSemigroup_eval, termProjection_apply] using
    (termProjection basis).map_eval substitution w

/-- The singleton classes form the canonical valuation of variables. -/
@[simp]
theorem termSemigroup_eval_singletonClass {α : Type u}
    (basis : List (Identity α)) (w : Word α) :
    (termSemigroup basis).eval
        (fun x => termClass basis (Word.singleton x)) w =
      termClass basis w := by
  simpa only [Word.bind_singleton] using
    (termClass_bind basis (fun x => Word.singleton x) w).symm

/-- The term semigroup presented by a basis satisfies every basis identity. -/
theorem termSemigroup_models {α : Type u}
    (basis : List (Identity α)) : Models (termSemigroup basis) basis := by
  intro e he valuation
  classical
  let representative : α → Word α := fun x =>
    Classical.choose
      ((derivationCongruence basis).projection_surjective (valuation x))
  have representative_class (x : α) :
      termClass basis (representative x) = valuation x := by
    change
      (derivationCongruence basis).projection.toFun (representative x) =
        valuation x
    dsimp [representative]
    exact Classical.choose_spec
      ((derivationCongruence basis).projection_surjective (valuation x))
  calc
    (termSemigroup basis).eval valuation e.lhs =
        (termSemigroup basis).eval
          (fun x => termClass basis (representative x)) e.lhs := by
      apply congrArg
        (fun rho : α → TermSemigroup basis =>
          (termSemigroup basis).eval rho e.lhs)
      funext x
      exact (representative_class x).symm
    _ = termClass basis (e.lhs.bind representative) :=
      (termClass_bind basis representative e.lhs).symm
    _ = termClass basis (e.rhs.bind representative) :=
      (termClass_eq_iff_derives basis).2
        (Derives.subst (Derives.fromBasis he) representative)
    _ = (termSemigroup basis).eval
          (fun x => termClass basis (representative x)) e.rhs :=
      termClass_bind basis representative e.rhs
    _ = (termSemigroup basis).eval valuation e.rhs := by
      apply congrArg
        (fun rho : α → TermSemigroup basis =>
          (termSemigroup basis).eval rho e.rhs)
      funext x
      exact representative_class x

/-- Equational completeness for semigroup identities over one universe. -/
theorem derives_iff_valid_in_all_models {α : Type u}
    (basis : List (Identity α)) (u v : Word α) :
    Derives basis u v ↔
      ∀ (S : Type u) (G : Semigroup S),
        Models G basis →
          ∀ valuation : α → S,
            G.eval valuation u = G.eval valuation v := by
  constructor
  · intro h S G hmodels valuation
    exact Derives.sound hmodels h valuation
  · intro h
    have hterm :=
      h (TermSemigroup basis) (termSemigroup basis)
        (termSemigroup_models basis)
        (fun x => termClass basis (Word.singleton x))
    refine (termClass_eq_iff_derives basis).mp ?_
    simpa only [termSemigroup_eval_singletonClass] using hterm

/-- Identity-level form of `derives_iff_valid_in_all_models`. -/
theorem derives_iff_satisfiedBy_all_models {α : Type u}
    (basis : List (Identity α)) (e : Identity α) :
    Derives basis e.lhs e.rhs ↔
      ∀ (S : Type u) (G : Semigroup S),
        Models G basis → e.SatisfiedBy G := by
  simpa only [Identity.SatisfiedBy] using
    (derives_iff_valid_in_all_models basis e.lhs e.rhs)

end SemigroupBasis
